<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>My Mesic — Your sound, your mood</title>
  <style>
    :root{--bg:#090b16;--panel:#121526;--soft:#1b1f35;--ink:#f7f6ff;--muted:#aaaec5;--pink:#ff4fa3;--purple:#9257ff;--cyan:#56ddf2;--line:rgba(255,255,255,.09)}
    *{box-sizing:border-box} body{margin:0;background:radial-gradient(circle at 72% -10%,#332064 0,transparent 31%),#090b16;color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif;min-height:100vh}
    button,input{font:inherit}.app{display:grid;grid-template-columns:240px minmax(0,1fr);min-height:100vh}.side{padding:26px 18px;border-right:1px solid var(--line);background:rgba(7,8,17,.6);position:sticky;top:0;height:100vh}.brand{display:flex;align-items:center;gap:10px;font-size:21px;font-weight:800;letter-spacing:-1px;margin:0 10px 36px}.mark{height:35px;width:35px;border-radius:12px;background:linear-gradient(135deg,var(--pink),var(--purple));display:grid;place-items:center;box-shadow:0 8px 24px #904fff55}.mark svg{width:20px;fill:#fff}.brand i{color:var(--pink);font-style:normal}.nav{display:grid;gap:7px}.nav button,.new-playlist{border:0;background:transparent;color:var(--muted);text-align:left;padding:12px 13px;border-radius:12px;cursor:pointer;font-weight:600}.nav button:hover,.nav .active{color:#fff;background:#ffffff12}.nav .active{box-shadow:inset 3px 0 var(--pink)}.side h4{color:#6e738d;font-size:11px;letter-spacing:1.3px;margin:32px 13px 10px}.new-playlist{color:var(--pink);margin-top:8px}.main{padding:30px 42px 110px;max-width:1500px;width:100%;margin:auto}.top{display:flex;justify-content:space-between;gap:20px;align-items:center}.welcome{font-size:13px;color:var(--muted)}h1{font-size:34px;letter-spacing:-1.5px;margin:4px 0}.search{width:min(355px,43vw);border:1px solid var(--line);background:#141729;color:white;padding:13px 17px;border-radius:14px;outline:none}.search:focus{border-color:var(--purple)}
    .hero{position:relative;overflow:hidden;margin-top:29px;min-height:240px;border-radius:24px;padding:34px;background:linear-gradient(110deg,#f34899,#8b4ae9 58%,#3d63bd);isolation:isolate}.hero:after,.hero:before{content:"";position:absolute;border:20px solid #fff2;border-radius:50%;width:260px;height:260px;right:-70px;bottom:-150px}.hero:before{width:150px;height:150px;right:120px;bottom:80px;border-color:#fff1}.hero>*{position:relative;z-index:1}.eyebrow{font-size:11px;letter-spacing:1.7px;font-weight:800;opacity:.8}.hero h2{font-size:34px;line-height:1.05;letter-spacing:-1.5px;max-width:430px;margin:14px 0}.hero p{max-width:420px;margin:0 0 20px;color:#fffD}.play{border:0;border-radius:12px;background:#fff;color:#782b90;font-weight:800;padding:12px 19px;cursor:pointer}.play:hover{transform:translateY(-1px)}.tabs{display:flex;align-items:center;gap:9px;margin:32px 0 18px;overflow:auto;padding-bottom:3px}.tabs button{border:1px solid var(--line);color:var(--muted);background:#121526;padding:9px 15px;border-radius:99px;white-space:nowrap;cursor:pointer;font-size:13px;font-weight:700}.tabs button.active{color:white;border-color:transparent;background:linear-gradient(100deg,var(--pink),var(--purple))}.section-title{display:flex;justify-content:space-between;align-items:center;margin:27px 0 13px}.section-title h3{margin:0;font-size:19px;letter-spacing:-.5px}.section-title span{font-size:12px;color:var(--pink);font-weight:700}.albums{display:grid;grid-template-columns:repeat(4,minmax(145px,1fr));gap:15px}.album{border:0;background:transparent;padding:0;color:white;text-align:left;cursor:pointer}.cover{aspect-ratio:1;border-radius:18px;margin-bottom:9px;position:relative;overflow:hidden;background:var(--c);box-shadow:inset 0 -50px 40px #0005}.cover:after{content:"♫";font-size:65px;font-weight:bold;position:absolute;right:16px;bottom:4px;color:#fff8}.cover b{position:absolute;left:14px;bottom:13px;z-index:1;font-size:15px;max-width:100px}.album small{color:var(--muted);font-size:12px}.tracks{background:var(--panel);border:1px solid var(--line);border-radius:18px;overflow:hidden}.track{display:grid;grid-template-columns:35px minmax(180px,2fr) 1fr 90px 35px;gap:12px;align-items:center;padding:12px 18px;border-bottom:1px solid var(--line);font-size:13px}.track:last-child{border:0}.track:hover{background:#ffffff09}.num{color:#777c98}.song{display:flex;align-items:center;gap:11px;font-weight:750}.art{width:36px;height:36px;border-radius:10px;background:var(--c);display:grid;place-items:center;color:#fff;flex:none}.artist,.duration{color:var(--muted)}.heart{background:none;border:0;color:#747b99;font-size:18px;cursor:pointer}.heart.liked{color:var(--pink)}.player{position:fixed;bottom:0;left:240px;right:0;height:76px;background:#101322f2;backdrop-filter:blur(16px);border-top:1px solid var(--line);display:flex;align-items:center;gap:22px;padding:12px 42px;z-index:3}.now{min-width:190px;display:flex;gap:10px;align-items:center;font-size:12px}.now b{display:block}.now span{color:var(--muted)}.controls{display:flex;align-items:center;gap:14px}.controls button{border:0;background:none;color:white;font-size:17px;cursor:pointer}.controls .round{height:34px;width:34px;border-radius:50%;background:linear-gradient(135deg,var(--pink),var(--purple))}.bar{height:4px;background:#ffffff1c;border-radius:4px;flex:1;max-width:510px}.bar i{display:block;height:100%;width:36%;background:linear-gradient(90deg,var(--pink),var(--cyan));border-radius:4px}.count{color:var(--muted);font-size:12px;margin-left:auto}
    @media(max-width:800px){.app{display:block}.side{position:fixed;z-index:4;bottom:0;top:auto;height:auto;left:0;right:0;padding:7px 10px;border-right:0;border-top:1px solid var(--line);display:flex;justify-content:center}.brand,.side h4,.new-playlist{display:none}.nav{display:flex;gap:3px}.nav button{font-size:11px;padding:10px}.main{padding:20px 18px 155px}.top{align-items:flex-start}.top h1{font-size:26px}.search{width:45vw;padding:11px}.hero{min-height:220px;padding:25px}.hero h2{font-size:28px}.albums{grid-template-columns:repeat(2,1fr)}.track{grid-template-columns:28px minmax(150px,1fr) 32px;padding:10px 12px}.track .artist,.track .duration{display:none}.player{left:0;padding:10px 18px;height:80px;gap:10px}.now{min-width:130px}.bar{display:none}.count{display:none}}
  </style>
</head>
<body>
<div class="app"><aside class="side"><div class="brand"><div class="mark"><svg viewBox="0 0 24 24"><path d="M19 3v12.5a4 4 0 1 1-2-3.46V7l-8 2v8.5a4 4 0 1 1-2-3.46V5z"/></svg></div>My <i>Mesic</i></div><nav class="nav"><button class="active" data-view="home">⌂ &nbsp; Home</button><button data-view="charts">◈ &nbsp; Top Charts</button><button data-view="love">♡ &nbsp; Love Vibes</button><button data-view="motivation">✦ &nbsp; Motivation</button><button data-view="liked">♥ &nbsp; Liked Songs</button></nav><h4>YOUR SPACE</h4><nav class="nav"><button>☾ &nbsp; Late Night Telugu</button><button>☀ &nbsp; Morning Boost</button></nav><button class="new-playlist">＋ New playlist</button></aside>
<main class="main"><header class="top"><div><div class="welcome">Your personal sound universe</div><h1 id="pageTitle">Good evening, Apsar ✦</h1></div><input class="search" id="search" placeholder="Search songs, artists, albums…" /></header>
<section class="hero"><div class="eyebrow">MADE FOR YOUR MOOD</div><h2>One place for every feeling.</h2><p>Find your Telugu and Hindi favourites — from heart-touching love songs to powerful motivation anthems.</p><label class="play" for="mp3Files">＋ Add my MP3 songs</label><input id="mp3Files" type="file" accept="audio/mpeg,audio/mp3" multiple hidden><small style="display:block;margin-top:12px;color:#fffC">Choose your own MP3 files. They stay private on your device.</small></section>
<div class="tabs" id="tabs"><button class="active" data-filter="all">All languages</button><button data-filter="Telugu">Telugu</button><button data-filter="Hindi">Hindi</button><button data-filter="Love">Love</button><button data-filter="Motivation">Motivation</button></div>
<div class="section-title"><h3>Pick your album mood</h3><span>Made uniquely for you</span></div><section class="albums"><button class="album" data-filter="Love"><div class="cover" style="--c:linear-gradient(135deg,#ff5c90,#9b3b9f)"><b>Love, in Telugu</b></div><small>Soft hearts · 75 songs</small></button><button class="album" data-filter="Motivation"><div class="cover" style="--c:linear-gradient(135deg,#f6a82d,#ef4e2d)"><b>Rise & Run</b></div><small>Motivation · 90 songs</small></button><button class="album" data-filter="Hindi"><div class="cover" style="--c:linear-gradient(135deg,#3cc0c6,#2455a3)"><b>Hindi Gold</b></div><small>Evergreen · 100 songs</small></button><button class="album" data-filter="Telugu"><div class="cover" style="--c:linear-gradient(135deg,#8053ee,#e83e95)"><b>Telugu Tapes</b></div><small>Latest & loved · 100 songs</small></button></section>
<div class="section-title"><h3 id="listTitle">Your Top 100</h3><span id="results">100 songs · tap to switch 100 / 250 / 500</span></div><section class="tracks" id="trackList"></section></main></div>
<footer class="player"><div class="now"><div class="art" id="nowArt" style="--c:linear-gradient(135deg,#fd6395,#874ee7)">♫</div><div><b id="nowTitle">Add MP3 songs to begin</b><span id="nowSub">Your music, on your device</span></div></div><div class="controls"><button id="previous">↶</button><button class="round" id="togglePlay">▶</button><button id="next">↷</button></div><div class="bar"><i></i></div><div class="count" id="queueCount">Add your MP3 files</div><audio id="audio" preload="metadata"></audio></footer>
<script>
const base=[
['Inthandham','Sita Ramam','Telugu','Love','#e94e9b'],['Samajavaragamana','Ala Vaikunthapurramuloo','Telugu','Love','#a65af4'],['Kesariya','Brahmāstra','Hindi','Love','#f08b33'],['Heeriye','Jasleen Royal','Hindi','Love','#df4c80'],['Naatu Naatu','RRR','Telugu','Motivation','#ef6932'],['Zinda','Bhaag Milkha Bhaag','Hindi','Motivation','#f3a826'],['Oh Sita Hey Rama','Sita Ramam','Telugu','Love','#597ae7'],['Apna Bana Le','Bhediya','Hindi','Love','#9a55d6'],['Maate Vinadhuga','Taxiwaala','Telugu','Love','#de4c77'],['Kar Har Maidaan Fateh','Sanju','Hindi','Motivation','#ec5d3b'],['Vellipomaakey','Saahasam Swaasaga Saagipo','Telugu','Love','#4eadd8'],['Lakshya','Lakshya','Hindi','Motivation','#f0932d'],['Adiga Adiga','Ninnu Kori','Telugu','Love','#d63b83'],['Ilahi','Yeh Jawaani Hai Deewani','Hindi','Motivation','#2f9db1'],['Nee Kannu Neeli Samudram','Uppena','Telugu','Love','#7b5ae8'],['Aarambh Hai Prachand','Gulaal','Hindi','Motivation','#d05245']];
const tracks=Array.from({length:500},(_,i)=>{let b=base[i%base.length];return {...{title:b[0],artist:b[1],lang:b[2],mood:b[3],color:b[4]},id:i+1,variant:i>15?' · '+(Math.floor(i/16)+1):''}});let filter='all',limit=100,liked=new Set(),current=tracks[0],playing=false;const audio=document.getElementById('audio');
function render(){let q=tracks.filter(t=>filter==='all'||t.lang===filter||t.mood===filter||(filter==='liked'&&liked.has(t.id))).slice(0,limit);document.getElementById('listTitle').textContent=filter==='liked'?'Your Liked Songs':`Your Top ${limit}`;document.getElementById('results').textContent=`${q.length} songs`;document.getElementById('trackList').innerHTML=q.map((t,i)=>`<div class="track"><span class="num">${String(i+1).padStart(2,'0')}</span><div class="song"><span class="art" style="--c:${t.color}">♫</span><span>${t.title}${t.variant}<small class="artist" style="display:block;font-weight:500">${t.artist}</small></span></div><span class="artist">${t.lang} · ${t.mood}</span><span class="duration">${3+(t.id%3)}:${String(8+t.id%50).padStart(2,'0')}</span><button class="heart ${liked.has(t.id)?'liked':''}" data-heart="${t.id}">♥</button></div>`).join('')||'<div class="track">No liked songs yet — tap the ♥ on a song to save it.</div>';document.querySelectorAll('[data-heart]').forEach(b=>b.onclick=()=>{liked.has(+b.dataset.heart)?liked.delete(+b.dataset.heart):liked.add(+b.dataset.heart);render()})}
function play(t){if(!t)return;current=t;playing=true;document.getElementById('nowTitle').textContent=t.title;document.getElementById('nowSub').textContent=t.artist;document.getElementById('nowArt').style.setProperty('--c',t.color);document.getElementById('togglePlay').textContent='❚❚';if(t.url){audio.src=t.url;audio.play().catch(()=>{playing=false;document.getElementById('togglePlay').textContent='▶'})}}
document.getElementById('trackList').onclick=e=>{let row=e.target.closest('.track');if(row&&!e.target.closest('.heart')){let n=+row.querySelector('.num').textContent;let q=tracks.filter(t=>filter==='all'||t.lang===filter||t.mood===filter||(filter==='liked'&&liked.has(t.id))).slice(0,limit);play(q[n-1])}};
document.querySelectorAll('[data-filter]').forEach(b=>b.onclick=()=>{filter=b.dataset.filter;document.querySelectorAll('#tabs button').forEach(x=>x.classList.toggle('active',x===b));render();window.scrollTo({top:400,behavior:'smooth'})});document.querySelectorAll('.nav button').forEach(b=>b.onclick=()=>{let f=b.dataset.view;if(!f)return;filter=f==='home'?'all':f==='charts'?'all':f;document.getElementById('pageTitle').textContent=f==='home'?'Good evening, Apsar ✦':b.textContent.trim();render()});document.getElementById('togglePlay').onclick=()=>{if(!audio.src)return;if(audio.paused){audio.play();playing=true}else{audio.pause();playing=false}document.getElementById('togglePlay').textContent=playing?'❚❚':'▶'};document.getElementById('previous').onclick=()=>{let i=tracks.indexOf(current);play(tracks[(i-1+tracks.length)%tracks.length])};document.getElementById('next').onclick=()=>{let i=tracks.indexOf(current);play(tracks[(i+1)%tracks.length])};audio.onended=()=>document.getElementById('next').click();audio.onpause=()=>{playing=false;document.getElementById('togglePlay').textContent='▶'};audio.onplay=()=>{playing=true;document.getElementById('togglePlay').textContent='❚❚'};document.getElementById('mp3Files').onchange=e=>{const files=[...e.target.files];if(!files.length)return;tracks.splice(0,tracks.length,...files.map((f,i)=>({id:i+1,title:f.name.replace(/\.mp3$/i,''),artist:'Your MP3 song',lang:'Your Music',mood:'MP3',color:`hsl(${(i*47+290)%360} 75% 58%)`,url:URL.createObjectURL(f)})));filter='all';limit=Math.max(100,tracks.length);document.getElementById('queueCount').textContent=`${tracks.length} MP3 songs ready`;render();play(tracks[0])};document.getElementById('search').oninput=e=>{let term=e.target.value.toLowerCase();document.querySelectorAll('.track').forEach(x=>x.style.display=x.textContent.toLowerCase().includes(term)?'grid':'none')};
// Top chart selection through keyboard-friendly prompt-free cycle
document.getElementById('results').onclick=()=>{limit=limit===100?250:limit===250?500:100;render()};render();
</script></body></html>
